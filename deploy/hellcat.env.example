# Extra command line arguments used by deploy/hellcat.service.
#
# Keep this file readable only by root (chmod 0640 root:hellcat) because the
# arguments may contain targets or operational details.

# Conservative default: 20 Xray processes, 200 workers total, 10k in-flight
# requests, CPU throttling enabled at 65%.
HELLCAT_ARGS=--instances 20 --threads 200 --inflight 10000 --cpu 65

# Examples:
# HELLCAT_ARGS=--insane --threads 400 --instances 40 --inflight 30000
# HELLCAT_ARGS=--stealth --threads 100 --duration 0 --cpu -1
# HELLCAT_ARGS=--target https://speed.cloudflare.com/__down?bytes=10737418240
